{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "AppDb": "Data Source=teacherslessons.db"
  },
  "Cors": {
    "AllowedOrigin": "http://localhost:4200"
  },
  "Ai": {
    "Enabled": true,
    "Model": "gemini-3.5-flash-lite",
    "MaxTokens": 512,
    "TimeoutSeconds": 6,
    "MaxQuestionLength": 300,
    "RateLimitPerMinute": 6,
    "RateLimitPerDay": 60
  }
}
